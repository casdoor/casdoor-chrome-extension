{
  "name": "Casdoor",
  "description": "Signs you into the systems without single sign-on by filling their sign-in forms with your accounts kept in Casdoor.",
  "version": "2.1.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "identity",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_popup": "/src/popup.html",
    "default_icon": {
      "16": "/images/icon16.png",
      "32": "/images/icon32.png",
      "48": "/images/icon48.png",
      "128": "/images/icon128.png"
    }
  },
  "icons": {
    "16": "/images/icon16.png",
    "32": "/images/icon32.png",
    "48": "/images/icon48.png",
    "128": "/images/icon128.png"
  },
  "background": {
    "service_worker": "/src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "/src/content-script.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
